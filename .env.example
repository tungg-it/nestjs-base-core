# Environment development / staging / production 
NODE_ENV=development

# Development mode (true: development, false: production)
DEV_MODE=true

# Server
API_PORT=8080

# Documentation
API_DOCUMENT=doc

# App roles
IS_API=true
IS_CONSUMER=false
IS_CRON=false

# gRPC server (plaintext is only allowed outside production)
GRPC_ENABLED=false
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_PLAINTEXT=true
GRPC_MAX_MESSAGE_BYTES=4194304
GRPC_MAX_TIMEOUT_MS=10000
GRPC_SHUTDOWN_GRACE_MS=10000
# GRPC_TLS_CERT_PATH=/run/secrets/grpc.crt
# GRPC_TLS_KEY_PATH=/run/secrets/grpc.key
# GRPC_TLS_CA_PATH=/run/secrets/grpc-ca.crt
# GRPC_TLS_REQUIRE_CLIENT_CERT=false
